generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  OWNER
  BRANCH_MANAGER
  PROJECT_MANAGER
  ESTIMATOR
  SITE_MANAGER
  ADMIN_KANTOR
  ARSITEK
  QC_INSPECTOR
  K3_OFFICER
  INTERIOR_DESIGNER
  KONSULTAN
  FINANCE
  CLIENT
  VENDOR
  HOME_OWNER
  MANDOR
  LOGISTIK
  SURVEYOR
}

enum ProjectStatus {
  PLANNING
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  DONE
  BLOCKED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
}

enum ApprovalType {
  RAB
  DESIGN
  PROGRESS_REPORT
  INVOICE
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum RABStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

enum LeadStatus {
  NEW
  CONTACTED
  QUOTED
  NEGOTIATION
  WON
  LOST
}

enum DocumentStatus {
  ACTIVE
  ARCHIVED
  DRAFT
}

model User {
  id        String    @id @default(cuid())
  email     String    @unique
  name      String
  password  String
  role      Role
  phone     String?
  avatar    String?
  isActive  Boolean   @default(true)
  lastLogin DateTime?
  branchId  String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?
  deletedBy String?

  branch Branch? @relation(fields: [branchId], references: [id])

  managedProjects    Project[]        @relation("ProjectManager")
  supervisedProjects Project[]        @relation("SiteManager")
  clientProfile      Client?
  reportedReports    ProgressReport[]
  attendances        Attendance[]
  assignedTasks      Task[]           @relation("Assignee")
  uploadedFiles      File[]
  notifications      Notification[]
  comments           Comment[]
  sentMessages       Message[]        @relation("Sender")
  receivedMessages   Message[]        @relation("Receiver")
  projectMembers     ProjectMember[]
  approvals          Approval[]       @relation("Approver")
  confirmedPayments  Payment[]
  auditLogs          AuditLog[]
  activityLogs       ActivityLog[]

  // Documents
  documentsUploaded Document[] @relation("DocumentUploader")

  // Assignments
  assignedLeads Lead[] @relation("LeadAssignee")
  createdLeads  Lead[] @relation("LeadCreator")

  @@index([email])
  @@index([role])
  @@index([branchId])
  @@map("users")
}

model Branch {
  id       String  @id @default(cuid())
  name     String  @unique
  address  String?
  phone    String?
  email    String?
  isActive Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?
  deletedBy String?

  users    User[]
  projects Project[]
  leads    Lead[]

  @@map("branches")
}

// ============================================================
// Company Profile — singleton row (id = "company")
// Settings module: company identity + financial defaults
// ============================================================
model CompanyProfile {
  id            String   @id @default("company")
  companyName   String   @default("Smart Konstruksi")
  tagline       String?
  address       String?
  phone         String?
  email         String?
  taxId         String?
  website       String?
  logoUrl       String?
  currency      String   @default("IDR")
  invoicePrefix String   @default("INV")
  taxRate       Decimal  @default(11)
  updatedBy     String?
  updatedAt     DateTime @updatedAt

  @@map("company_profiles")
}

model Project {
  id          String        @id @default(cuid())
  code        String        @unique
  name        String
  description String?
  address     String
  startDate   DateTime
  endDate     DateTime?
  budget      Decimal       @db.Decimal(15, 2)
  actualCost  Decimal?      @db.Decimal(15, 2)
  progress    Int           @default(0)
  status      ProjectStatus @default(PLANNING)
  branchId    String

  projectManagerId String
  siteManagerId    String?
  clientId         String

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?
  deletedBy String?

  branch         Branch @relation(fields: [branchId], references: [id])
  projectManager User   @relation("ProjectManager", fields: [projectManagerId], references: [id])
  siteManager    User?  @relation("SiteManager", fields: [siteManagerId], references: [id])
  client         Client @relation(fields: [clientId], references: [id])

  progressReports ProgressReport[]
  tasks           Task[]
  files           File[]
  invoices        Invoice[]
  comments        Comment[]
  members         ProjectMember[]
  approvals       Approval[]
  activityLogs    ActivityLog[]
  attendances     Attendance[]
  transactions    Transaction[]
  documents       Document[]

  @@index([branchId])
  @@index([status])
  @@index([projectManagerId])
  @@index([clientId])
  @@index([code])
  @@map("projects")
}

model Client {
  id          String  @id @default(cuid())
  userId      String  @unique
  companyName String?
  address     String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?
  deletedBy String?

  user     User      @relation(fields: [userId], references: [id])
  projects Project[]

  @@map("clients")
}

model ProjectMember {
  id        String @id @default(cuid())
  projectId String
  userId    String
  role      Role

  createdAt DateTime @default(now())
  createdBy String?

  project Project @relation(fields: [projectId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
  @@map("project_members")
}

model MaterialCategory {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?
  deletedBy String?

  materials Material[]

  @@map("material_categories")
}

model Vendor {
  id         String  @id @default(cuid())
  name       String
  phone      String?
  email      String?
  address    String?
  isVerified Boolean @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?
  deletedBy String?

  materials Material[]

  @@map("vendors")
}

model Material {
  id       String  @id @default(cuid())
  name     String
  unit     String
  stock    Float   @default(0)
  minStock Float   @default(0)
  avgPrice Decimal @default(0) @db.Decimal(15, 2)
  notes    String?

  categoryId String?
  vendorId   String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?
  deletedBy String?

  category MaterialCategory? @relation(fields: [categoryId], references: [id])
  vendor   Vendor?           @relation(fields: [vendorId], references: [id])

  transactions Transaction[]

  @@index([categoryId])
  @@index([vendorId])
  @@index([name])
  @@map("materials")
}

model Transaction {
  id         String   @id @default(cuid())
  type       String   // IN / OUT
  purpose    String   @default("OPERATIONAL") // MATERIAL_PURCHASE, OPERATIONAL, PROJECT_USAGE, WASTE, RETURN, ADJUSTMENT
  materialId String
  qty        Float
  price      Decimal? @db.Decimal(15, 2)
  totalCost  Decimal  @db.Decimal(15, 2)
  projectId  String?
  date       DateTime @default(now())
  notes      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?

  material Material @relation(fields: [materialId], references: [id])
  project  Project? @relation(fields: [projectId], references: [id])

  @@index([materialId])
  @@index([projectId])
  @@index([type])
  @@index([date])
  @@map("transactions")
}

model ProgressReport {
  id          String   @id @default(cuid())
  projectId   String
  reporterId  String
  reportDate  DateTime
  percentage  Int
  description String
  weather     String?
  latitude    Float?
  longitude   Float?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?
  deletedBy String?

  project  Project   @relation(fields: [projectId], references: [id])
  reporter User      @relation(fields: [reporterId], references: [id])
  photos   File[]    @relation("ReportPhotos")
  comments Comment[]

  @@index([projectId])
  @@index([reporterId])
  @@index([reportDate])
  @@map("progress_reports")
}

model Task {
  id          String       @id @default(cuid())
  projectId   String
  assigneeId  String?
  title       String
  description String?
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  startDate   DateTime
  dueDate     DateTime
  completedAt DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?
  deletedBy String?

  project    Project     @relation(fields: [projectId], references: [id])
  assignee   User?       @relation("Assignee", fields: [assigneeId], references: [id])
  checklists Checklist[]

  @@index([projectId])
  @@index([assigneeId])
  @@index([status])
  @@index([dueDate])
  @@map("tasks")
}

model Checklist {
  id     String  @id @default(cuid())
  taskId String
  title  String
  isDone Boolean @default(false)

  createdAt DateTime @default(now())
  createdBy String?

  task Task @relation(fields: [taskId], references: [id])

  @@index([taskId])
  @@map("checklists")
}

model Attendance {
  id        String    @id @default(cuid())
  userId    String
  projectId String
  checkIn   DateTime
  checkOut  DateTime?
  latitude  Float?
  longitude Float?
  photoUrl  String?
  notes     String?

  createdAt DateTime @default(now())
  createdBy String?

  user    User    @relation(fields: [userId], references: [id])
  project Project @relation(fields: [projectId], references: [id])

  @@index([userId])
  @@index([projectId])
  @@index([checkIn])
  @@map("attendances")
}

model File {
  id         String  @id @default(cuid())
  filename   String
  url        String
  size       Int
  mimeType   String
  uploaderId String
  projectId  String?
  reportId   String?

  createdAt DateTime @default(now())
  createdBy String?

  uploader User            @relation(fields: [uploaderId], references: [id])
  project  Project?        @relation(fields: [projectId], references: [id])
  report   ProgressReport? @relation("ReportPhotos", fields: [reportId], references: [id])

  @@index([projectId])
  @@index([uploaderId])
  @@index([reportId])
  @@map("files")
}

model Lead {
  id         String     @id @default(cuid())
  name       String
  company    String?
  phone      String?
  email      String?
  source     String?
  status     LeadStatus @default(NEW)
  type       String?
  budgetMin  Decimal?   @db.Decimal(15, 2)
  budgetMax  Decimal?   @db.Decimal(15, 2)
  location   String?
  notes      String?
  assignedTo String?
  branchId   String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?
  deletedBy String?

  assignedUser User?      @relation("LeadAssignee", fields: [assignedTo], references: [id])
  branch       Branch?    @relation(fields: [branchId], references: [id])
  creator      User?      @relation("LeadCreator", fields: [createdBy], references: [id])
  rabs         RAB[]
  approvals    Approval[]

  @@index([status])
  @@index([assignedTo])
  @@index([branchId])
  @@index([createdAt])
  @@map("leads")
}

model RAB {
  id      String    @id @default(cuid())
  code    String    @unique
  leadId  String
  title   String
  total   Decimal   @default(0) @db.Decimal(15, 2)
  marginPercent Decimal @default(0) @db.Decimal(5, 2)
  status  RABStatus @default(DRAFT)
  notes   String?
  version Int       @default(1)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?
  deletedBy String?

  lead  Lead      @relation(fields: [leadId], references: [id])
  items RABItem[]

  @@index([leadId])
  @@index([status])
  @@index([code])
  @@map("rabs")
}

model RABItem {
  id        String  @id @default(cuid())
  rabId     String
  section   String
  name      String
  unit      String
  qty       Decimal @db.Decimal(15, 2)
  unitPrice Decimal @db.Decimal(15, 2)
  total     Decimal @db.Decimal(15, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?

  rab RAB @relation(fields: [rabId], references: [id])

  @@index([rabId])
  @@map("rab_items")
}

model Invoice {
  id        String        @id @default(cuid())
  projectId String
  invoiceNo String        @unique
  amount    Decimal       @db.Decimal(15, 2)
  status    InvoiceStatus @default(DRAFT)
  issuedAt  DateTime
  dueDate   DateTime
  paidAt    DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?
  deletedBy String?

  project  Project   @relation(fields: [projectId], references: [id])
  payments Payment[]

  @@index([projectId])
  @@index([status])
  @@index([invoiceNo])
  @@map("invoices")
}

model Payment {
  id            String    @id @default(cuid())
  invoiceId     String
  amount        Decimal   @db.Decimal(15, 2)
  method        String
  proofUrl      String?
  paidAt        DateTime
  confirmedById String?
  confirmedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?
  updatedBy String?

  invoice     Invoice @relation(fields: [invoiceId], references: [id])
  confirmedBy User?   @relation(fields: [confirmedById], references: [id])

  @@index([invoiceId])
  @@index([confirmedById])
  @@map("payments")
}

model Approval {
  id         String         @id @default(cuid())
  type       ApprovalType
  entityId   String
  projectId  String?
  leadId     String?
  approverId String
  status     ApprovalStatus @default(PENDING)
  notes      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?
  updatedBy String?

  project  Project? @relation(fields: [projectId], references: [id])
  lead     Lead?    @relation(fields: [leadId], references: [id])
  approver User     @relation("Approver", fields: [approverId], references: [id])

  @@index([type, entityId])
  @@index([projectId])
  @@index([leadId])
  @@index([approverId])
  @@index([status])
  @@map("approvals")
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String
  title     String
  message   String
  link      String?
  isRead    Boolean   @default(false)
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
  @@map("notifications")
}

model Comment {
  id        String  @id @default(cuid())
  content   String
  authorId  String
  projectId String
  reportId  String?

  createdAt DateTime @default(now())
  createdBy String?

  author  User            @relation(fields: [authorId], references: [id])
  project Project         @relation(fields: [projectId], references: [id])
  report  ProgressReport? @relation(fields: [reportId], references: [id])

  @@index([projectId])
  @@index([authorId])
  @@index([reportId])
  @@map("comments")
}

model Message {
  id         String  @id @default(cuid())
  senderId   String
  receiverId String
  content    String
  read       Boolean @default(false)
  projectId  String?

  createdAt DateTime @default(now())
  createdBy String?

  sender   User @relation("Sender", fields: [senderId], references: [id])
  receiver User @relation("Receiver", fields: [receiverId], references: [id])

  @@index([senderId])
  @@index([receiverId])
  @@index([projectId])
  @@map("messages")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  entity    String
  entityId  String
  oldData   Json?
  newData   Json?
  ipAddress String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String?
  projectId String?
  type      String
  title     String
  message   String
  metadata  Json?
  createdAt DateTime @default(now())

  user    User?    @relation(fields: [userId], references: [id])
  project Project? @relation(fields: [projectId], references: [id])

  @@index([userId])
  @@index([projectId])
  @@index([type])
  @@index([createdAt])
  @@map("activity_logs")
}

model DocumentCategory {
  id          String     @id @default(cuid())
  name        String     @unique
  description String?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?
  deletedBy String?

  documents Document[]

  @@map("document_categories")
}

model Document {
  id              String         @id @default(cuid())
  name            String
  description     String?
  fileUrl         String
  fileType        String
  fileSize        Int
  categoryId      String
  projectId       String
  uploaderId      String
  status          DocumentStatus @default(ACTIVE)
  expiryDate      DateTime?
  isClientVisible Boolean        @default(false)
  version         Int            @default(1)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?
  updatedBy String?

  category DocumentCategory @relation(fields: [categoryId], references: [id])
  project  Project          @relation(fields: [projectId], references: [id])
  uploader User             @relation("DocumentUploader", fields: [uploaderId], references: [id])

  @@index([categoryId])
  @@index([projectId])
  @@index([uploaderId])
  @@index([status])
  @@map("documents")
}

